# Copy this file to ".env" and adjust. The real .env is never committed to git.

# "development" enables /docs and the /api/dev tools. Use "production" when deployed.
APP_ENV=development

# Local development uses a SQLite file (no install needed).
# For PostgreSQL (e.g. AWS RDS) only this line changes. If the password contains special
# characters (@ : / # %) they must be URL-encoded.
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/fitrehab
DATABASE_URL=sqlite:///./fitrehab.db

# Used to sign login tokens. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Minutes a login token stays valid (default 1 day)
ACCESS_TOKEN_MINUTES=1440

# Frontend addresses allowed to call this API (comma separated). Not needed when the
# frontend and the API are served from the same address, as in production behind CloudFront.
CORS_ORIGINS=http://localhost:5173

# Production only: the secret that CloudFront sends in the X-Origin-Verify header.
# Leave empty in development.
ORIGIN_SECRET=

# Premium price (in cents) and length of one paid period
PREMIUM_PRICE_CENTS=14900
PREMIUM_CURRENCY=EGP
PREMIUM_PERIOD_DAYS=30
